{
  "name": "nook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "eval:validate": "node --experimental-strip-types scripts/validate-fixtures.mts",
    "test:hedge": "node --experimental-strip-types --test tests/hedge.test.mts",
    "test:judge": "node --experimental-strip-types --test tests/judge.test.mts",
    "eval:judge:validate": "node --experimental-strip-types scripts/eval-core.mts --dry",
    "eval": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/eval-judge.mts",
    "test:judge-model": "node --experimental-strip-types --test tests/judge-model.test.mts"
  },
  "dependencies": {
    "@seed-design/css": "2.7.0",
    "@seed-design/react": "2.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "openai": "7.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
