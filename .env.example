# STEP 1 landing page + /api/health work without these values.
# Copy to .env.local. Never commit real values.

# Public Supabase project values. RLS must be configured before data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS; the API must verify the signed-in user and row owner.
SUPABASE_SECRET_KEY=

# Server only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
NOOK_JUDGE_MODEL=
NOOK_JUDGE_REASONING_EFFORT=
NOOK_JUDGE_MAX_OUTPUT_TOKENS=

# Evaluation only: gpt-5.6-luna, gpt-5.6-terra, or gpt-5.6-sol.
# Alternatively pass npm run eval -- --model ID.
NOOK_EVAL_MODEL=

# Server-only canonical app origin for OAuth and same-origin POST checks.
# Set separately for each deployment; Supabase redirect allowlist must match.
NOOK_SITE_URL=

# Keep unset until CAPTCHA enforcement, throttling and start flow are wired.
NOOK_ANONYMOUS_SIGN_IN_ENABLED=

# Server-only start API rollout. Enable after Safety contract/evaluation and HTTP verification.
NOOK_START_API_ENABLED=
# Stable independent HMAC secret, at least 32 characters. Never expose signed receipts in URLs/logs.
NOOK_REQUEST_HMAC_SECRET=
NOOK_SAFETY_MODEL=
NOOK_SAFETY_REASONING_EFFORT=
NOOK_SAFETY_MAX_OUTPUT_TOKENS=
NOOK_START_MODEL=
NOOK_START_REASONING_EFFORT=
NOOK_START_MAX_OUTPUT_TOKENS=
NOOK_NODE_ZERO_MODEL=
NOOK_NODE_ZERO_REASONING_EFFORT=
NOOK_NODE_ZERO_MAX_OUTPUT_TOKENS=
