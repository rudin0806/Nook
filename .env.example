# STEP 1 landing page + /api/health work without these values.
# Copy to .env.local. Never commit real values.

# Public Supabase project values. RLS must be configured before data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS; the API must verify the signed-in user and row owner.
SUPABASE_SECRET_KEY=

# Server only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Operating values (2026-09-18): model gpt-5.6-sol, effort medium.
# The effort was lowered from high because a measured turn took 15.3s end to
# end and the Judge alone averaged 6.4s. The model is unchanged. The strict
# 31/31 regression was recorded at high, so it no longer covers this setting.
NOOK_JUDGE_MODEL=
NOOK_JUDGE_REASONING_EFFORT=
NOOK_JUDGE_MAX_OUTPUT_TOKENS=

# Evaluation only: gpt-5.6-luna, gpt-5.6-terra, or gpt-5.6-sol.
# Alternatively pass npm run eval -- --model ID.
NOOK_EVAL_MODEL=

# Server-only canonical app origin for OAuth and same-origin POST checks.
# Production/local use NOOK_SITE_URL. Preview uses trusted VERCEL_ENV + VERCEL_URL.
# Enable Vercel system environment variables; do not manually set VERCEL_URL.
# Supabase redirect allowlist must include the Preview /api/auth/callback URL.
NOOK_SITE_URL=

# Keep unset until CAPTCHA enforcement, throttling and start flow are wired.
NOOK_ANONYMOUS_SIGN_IN_ENABLED=
# Public CAPTCHA site key. Set the ONE that matches the provider selected in
# Supabase Auth > Attack Protection; a token from the other provider is rejected.
# The matching secret and the enforcement toggle belong in Supabase, not here.
# NEXT_PUBLIC_* values are inlined at build time, so a change needs a redeploy.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only start API rollout. Enable after Safety contract/evaluation and HTTP verification.
NOOK_START_API_ENABLED=
# Stable independent HMAC secret, at least 32 characters. Never expose signed receipts in URLs/logs.
NOOK_REQUEST_HMAC_SECRET=
NOOK_SAFETY_MODEL=
NOOK_SAFETY_REASONING_EFFORT=
NOOK_SAFETY_MAX_OUTPUT_TOKENS=
NOOK_START_MODEL=
NOOK_START_REASONING_EFFORT=
NOOK_START_MAX_OUTPUT_TOKENS=
NOOK_NODE_ZERO_MODEL=
NOOK_NODE_ZERO_REASONING_EFFORT=
NOOK_NODE_ZERO_MAX_OUTPUT_TOKENS=

# Conversation rollout: enable only after DB migration, generation evaluation and HTTP checks.
NOOK_CONVERSATION_API_ENABLED=
NOOK_REFRAME_MODEL=
NOOK_REFRAME_REASONING_EFFORT=
NOOK_REFRAME_MAX_OUTPUT_TOKENS=
NOOK_REFLECT_MODEL=
NOOK_REFLECT_REASONING_EFFORT=
NOOK_REFLECT_MAX_OUTPUT_TOKENS=

# Production-only retention maintenance. Leave disabled until scheduling is approved.
# Independent random secret, at least 32 characters; never expose to browser.
CRON_SECRET=
NOOK_RETENTION_CRON_ENABLED=
