# Copy to .env.local. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI
OPENAI_API_KEY=

# Canonical application origin used by OAuth and same-origin checks
NOOK_SITE_URL=

# CAPTCHA: configure the matching provider in Supabase Auth
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Feature flags
NOOK_ANONYMOUS_SIGN_IN_ENABLED=
NOOK_START_API_ENABLED=
NOOK_CONVERSATION_API_ENABLED=
NOOK_RETENTION_CRON_ENABLED=

# Signing and scheduled cleanup
NOOK_REQUEST_HMAC_SECRET=
CRON_SECRET=

# AI stages
# Each stage accepts its own model, reasoning effort and output-token limit.
NOOK_SAFETY_MODEL=
NOOK_SAFETY_REASONING_EFFORT=
NOOK_SAFETY_MAX_OUTPUT_TOKENS=

NOOK_START_MODEL=
NOOK_START_REASONING_EFFORT=
NOOK_START_MAX_OUTPUT_TOKENS=

NOOK_NODE_ZERO_MODEL=
NOOK_NODE_ZERO_REASONING_EFFORT=
NOOK_NODE_ZERO_MAX_OUTPUT_TOKENS=

NOOK_JUDGE_MODEL=
NOOK_JUDGE_REASONING_EFFORT=
NOOK_JUDGE_MAX_OUTPUT_TOKENS=

NOOK_REFRAME_MODEL=
NOOK_REFRAME_REASONING_EFFORT=
NOOK_REFRAME_MAX_OUTPUT_TOKENS=

NOOK_REFLECT_MODEL=
NOOK_REFLECT_REASONING_EFFORT=
NOOK_REFLECT_MAX_OUTPUT_TOKENS=

# Evaluation only
NOOK_EVAL_MODEL=
